# Octofit Tracker Frontend Environment Configuration
# Copy this file to .env.local and update with your actual values

# REQUIRED: GitHub Codespace name for API endpoint construction
# This is used to build the API base URL: https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api
# Example: my-codespace-abc123
# 
# To find your Codespace name:
# 1. Open your GitHub Codespace
# 2. Look at the browser URL: https://${CODESPACE_NAME}.github.dev
# 3. Copy the CODESPACE_NAME part
#
# If not set, the app will fall back to http://localhost:8000 for local development
VITE_CODESPACE_NAME=your-codespace-name
